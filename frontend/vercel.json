{
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://gateway.ysiddo-ai-projects.app/intelai/docs"
    },
    {
      "source": "/docs/(.*)",
      "destination": "https://gateway.ysiddo-ai-projects.app/intelai/docs/$1"
    },
    {
      "source": "/openapi.json",
      "destination": "https://gateway.ysiddo-ai-projects.app/intelai/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}