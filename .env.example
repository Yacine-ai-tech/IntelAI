# IntelAI example environment — copy to .env and fill in.

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=[YOUR_FRONTEND_URL],[YOUR_OTHER_FRONTEND_URL]

# ── Localization ─────────────────────────────────────────────────────────────
# UI/insight language: en | fr (bilingual). Affects executive summaries + number formats.
DEFAULT_LANGUAGE=en
# Display currency (ISO 4217) for KPI/insight formatting: USD | EUR | GBP | XOF (FCFA) | …
# Presentation only — does not perform FX conversion. e.g. XOF renders "1,2 Md FCFA" in fr.
CURRENCY=USD

# ── Database (Postgres) + vector store ──────────────────────────────────────
POSTGRES_URL=postgresql://intelai:change_me@localhost:5432/intelai
CHROMA_DB_PATH=./chroma_db
# Vector store: chroma (dev) | qdrant (prod; Qdrant Cloud TLS endpoint uses port 6333)
VECTOR_STORE=chroma
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=8

# ── LLM providers (Groq required; Anthropic/OpenAI optional) ────────────────
# Optional: spread load over several keys of the same provider. Any variable named
# <PROVIDER>_API_KEY_<suffix> (or a comma-separated <PROVIDER>_API_KEYS list) is picked up
# at startup and used round-robin; a key that hits a rate limit is skipped until its
# retry window passes. <PROVIDER>_KEY_SLOTS (e.g. "1,3") pins this deployment to a subset.
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=
TAVILY_API_KEY=your_tavily_api_key_here
# Multi-provider tiers (LiteLLM router)
LLM_DEFAULT=groq/openai/gpt-oss-120b
LLM_REASONING=gemini/gemini-3.5-flash-lite
LLM_JUDGE=anthropic/claude-haiku-4-5
# Optional zero-trust dynamic fallback models when primary keys are unavailable or rate-limited:
LLM_REASONING_FALLBACK=groq/openai/gpt-oss-120b
LLM_JUDGE_FALLBACK=                              # e.g. groq/meta-llama/llama-4-maverick-17b-128e-instruct or gemini/gemini-2.0-flash

# ── Retrieval ───────────────────────────────────────────────────────────────
# Local hybrid RAG: BGE-M3 dense embeddings + BM25 fused by RRF, then local BGE reranking.
# Model weights are downloaded on first use and should be persisted in HF_HOME.
USE_HYBRID_RETRIEVAL=true
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PROVIDER=local
USE_RERANKER=true
EMBED_BATCH_SIZE=16
RERANK_MAX_LENGTH=256
# Cross-encoder scoring batch (also the progress/cancel granularity).
RERANK_BATCH_SIZE=8
# Retrieval pool: dense top-N + BM25 top-N -> RRF -> rerank the top RERANK_CANDIDATES.
RETRIEVAL_DENSE_K=50
RETRIEVAL_SPARSE_K=50
RERANK_CANDIDATES=12

# ── Embeddings: EXACTLY ONE mode runs. No fallback chain. ───────────────────
#   local   load the model in-process on this host. Requires sentence-transformers and
#           CPU PyTorch (installed from requirements.txt), plus enough RAM for both models.
#   remote  call EMBED_URL. Nothing is loaded locally.
# If the configured mode can't run, retrieval raises a real error instead of quietly
# switching modes — a silent swap changes retrieval quality and hides a down host.
# Host implementing {"texts":[...],"model":"..."} -> {"embeddings":[...]} at {url}/embed
# (your own inference service, or any host implementing the same contract).
# A Hugging Face Inference API model URL is also accepted and called in HF's native shape.
EMBED_URL=
# Bearer token for EMBED_URL and RERANK_URL below (one shared inference-host token).
INFERENCE_TOKEN=

# ── Reranking: EXACTLY ONE provider runs. No fallback chain. ────────────────
#   local   cross-encoder in-process using BAAI/bge-reranker-v2-m3.
#   remote  RERANK_URL, same dispatch as EMBED_URL above — a Hugging Face Inference API
#           model URL is called in HF's native shape (uses INFERENCE_TOKEN); anything
#           else via {"query","texts":[...]} -> {"scores":[...]} (your own service,
#           or any compliant host)
#   hf      Same as remote+a huggingface.co URL, kept as an explicit shortcut
#           (needs HF_TOKEN specifically, not INFERENCE_TOKEN)
#   jina    Jina /v1/rerank (needs JINA_API_KEY)
# On failure, reranking is skipped (RRF fusion order kept) and the real error is logged —
# it never silently reranks with a different provider than the one you configured.
# Set USE_RERANKER=false to disable reranking entirely.
RERANK_URL=

# ── Retrieval timeouts: a real quality/latency tradeoff, not just plumbing ──
# EMBED_TIMEOUT / RERANK_TIMEOUT (per-attempt socket timeout) and
# INFERENCE_WAKE_TIMEOUT (total retry budget across attempts) govern a real remote
# host's response to a genuinely compute-bound call — a cross-encoder reranking real
# content takes tens of seconds, not milliseconds, on a modest inference host.
#   Tight (e.g. 15/15/40s) — a slow rerank call gets abandoned quickly and falls back
#     to plain RRF fusion order (see USE_HYBRID_RETRIEVAL) instead of an actually-
#     reranked result. Right if callers hit the SYNCHRONOUS chat/admin endpoints
#     directly, where a request sitting open too long risks a reverse proxy (typically
#     around 100-125s) cutting the connection before a slow-but-
#     correct response comes back.
#   Generous (e.g. 30/60/120s) — genuine reranking gets to complete. Only safe if
#     callers use the async job+poll endpoints (POST .../async + GET .../{job_id},
#     both for /api/v1/chat and /api/v1/admin/scenario) rather than the plain
#     synchronous ones, since nothing then needs to hold one HTTP connection open for
#     the whole duration.
EMBED_TIMEOUT=15
RERANK_TIMEOUT=15
INFERENCE_WAKE_TIMEOUT=40
# Retrieval time budget = BASE + PER_PAIR x pool size. Set VECTOR_RETRIEVAL_TIMEOUT to pin it.
RETRIEVAL_BASE_TIMEOUT=15
RETRIEVAL_TIMEOUT_PER_PAIR=1.5
# Return the fused (RRF) ranking, flagged partial, when the budget runs out during reranking.
RETRIEVAL_ALLOW_PARTIAL=true
CHAT_TURN_TIMEOUT=180
# GraphRAG-lite: entity-graph ranking of KPI records for multi-hop queries (cheap, on).
USE_GRAPH_RAG=true

# ── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string_in_production
SESSION_TIMEOUT=3600
ALLOW_INSECURE_DEFAULT_USERS=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Internal service auth / E2E testing ─────────────────────────────────────
# Every route except /health, /docs, and /api/v1/auth/* requires a matching
# X-OmniIntel-Internal-Token header when REQUIRE_INTERNAL_TOKEN=true (the default).
# The bundled frontend does NOT send this header — it's meant for a gateway/reverse-proxy
# sitting in front to attach. Self-hosting standalone (docker compose up, no gateway)?
# Set REQUIRE_INTERNAL_TOKEN=false below, or see SELF_HOSTING.md for the alternative.
REQUIRE_INTERNAL_TOKEN=true
# Shared secret for internal service-to-service auth via the X-IntelAI-Internal-Token
# header. Must match the value configured on the gateway and all other IntelAI services.
INTELAI_INTERNAL_TOKEN=
# Password for the E2E test admin login (frontend/e2e/*.spec.ts). Must match the
# deployed admin account (see BOOTSTRAP_ADMIN_PASSWORD above).

# ── Demo isolation (public hosted demo only) ────────────────────────────────
# DEMO_MODE: explicitly enables password-less non-admin demo personas.
DEMO_MODE=false
# DEMO_SESSION_SCOPING: when true (default), each browser gets its own ephemeral
# identity per persona so one visitor's chat sessions, uploaded files, and ingested
# KPI data aren't visible to a different visitor who tries the same persona. The
# seeded/global demo dataset stays visible to everyone either way. This is anonymous
# demo isolation, not production multi-tenant auth — a real deployment with real
# users should layer its own auth on top rather than rely on this. Safe to leave on
# for single-operator self-hosting; only disable if you understand the tradeoff.
DEMO_SESSION_SCOPING=true

# ── External processor delegation (ingestion pipeline) ──────────────────────
# IntelAI's ingestion pipeline calling out to a pluggable audio/document
# processor — not hardcoded to any specific sibling project. Empty by
# default: the audio-ingest endpoint returns 501 and the document-ingest
# endpoint keeps using its built-in extraction until you configure these.
#
# AUDIO_PROCESSOR_URL: base URL of an audio processor implementing
#   POST {url}/pipeline (multipart `file` in, {"transcript","analysis"} JSON
#   out) — a VoiceFlow instance speaks this natively, but any compliant
#   service works. Enables POST /api/v1/ingest/audio.
AUDIO_PROCESSOR_URL=
AUDIO_PROCESSOR_TOKEN=
# DOC_PROCESSOR_URL: base URL of a document/image processor. IntelAI does no
#   extraction of its own — no pypdf, no vision model — so document and image
#   ingestion is DISABLED until this is set, and a failing processor surfaces
#   as a 502 rather than as silently degraded text. The processor must
#   implement one of (tried in this order):
#     POST {url}/extract/text   -> {"text": "..."}      full document text
#     POST {url}/extract/marker -> {"markdown": "..."}  PDF -> Markdown
#     POST {url}/process        -> {"raw_text"|"fields"}
#   A DocIntel instance speaks all three natively.
DOC_PROCESSOR_URL=
DOC_PROCESSOR_TOKEN=
# The two route-taking endpoints do NOT share a route vocabulary, so they get
# one setting each — sending one value to both makes whichever endpoint does
# not recognise it fall back to its weakest path, silently.
#   DOC_PROCESSOR_TEXT_ROUTE -> /extract/text: auto | marker | ocr
#     "ocr" reads the PDF's native text layer: fast, $0, and correct for
#     digital PDFs. "auto" prefers Marker (structured Markdown), which is
#     higher quality for RAG but can take minutes on a long document.
#   DOC_PROCESSOR_ROUTE -> /process: vision_route_a (hosted vision model, paid
#     per page) | vision_route_b (self-hosted vision, $0) | ocr_fallback
#     (Tesseract, $0)
DOC_PROCESSOR_TEXT_ROUTE=ocr
DOC_PROCESSOR_ROUTE=ocr_fallback
# A non-empty extraction shorter than this is treated as a failure, so the next
# endpoint is tried and the longest result wins. Without it, a near-empty
# result (32 characters from a 1.2MB report) is accepted as success and hides
# a document the processor cannot actually read.
DOC_PROCESSOR_MIN_CHARS=200
# Seconds to wait on the processor before giving up.
DOC_PROCESSOR_TIMEOUT=180

# Shared secret for the public, HMAC-signed ingestion webhook
# (POST /api/v1/webhook/{source_name}) — the machine-to-machine path any
# external pusher (StreamPulse, a Kafka HTTP sink connector, n8n, VoiceFlow's
# own signed /integrations/relay) can call without a live user JWT. Sign the
# raw request body with HMAC-SHA256 and this secret, send it as
# `X-Signature-256: sha256=<hex>` — the same convention StreamPulse's own
# webhook_receiver.py verifies. Empty by default: the endpoint returns 501
# and refuses all requests rather than silently accepting unauthenticated
# data.
INGEST_WEBHOOK_SECRET=

# RAG evaluation — generic, not hardcoded to any specific evaluator service.
# Used two ways: (1) scripts/evaluate_with_rageval.py, an offline batch run over
# tests/rag_eval.jsonl; (2) live dogfooding — every persona chat reply is POSTed
# in the background to {url}/eval/log (fire-and-forget, never blocks the chat
# response) for real-time quality/cost scoring. Both points expect a service
# implementing POST {url}/eval/log|score with {query,answer,contexts,persona} in ->
# {overall_quality,groundedness,...} out. The upstream RAGeval project is one
# example; bring your own if you'd rather. Empty = both paths no-op rather than
# silently defaulting to someone else's server.
RAG_EVALUATOR_URL=
# Sent as both `Authorization: Bearer` (generic — any compatible evaluator) and
# `X-OmniIntel-Internal-Token` (what the upstream RAGeval project's own gate actually
# checks by default). Pointing at a real RAGeval deployment? Set this to the same value
# as that deployment's RAGEVAL_INTERNAL_TOKEN, or it 403s silently in the background.
RAG_EVALUATOR_TOKEN=

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_RAG=true
FEATURE_MONTE_CARLO=true

# --- Anonymous Startup Telemetry ---
# A single anonymous startup ping ({service, event, version, instance_id}; no personal data or
# logs), on by default. Left unset (or empty) TELEMETRY_URL sends it to the project's collector;
# set your own collector URL to redirect it. TELEMETRY_OPT_OUT=true or DO_NOT_TRACK=1 turns it off.
TELEMETRY_OPT_OUT=false
# TELEMETRY_URL=

# ═══════════════════════════════════════════════════════════════════════════
# Additional settings. Every variable below is optional; defaults are shown.
# ═══════════════════════════════════════════════════════════════════════════

# ── Logging ─────────────────────────────────────────────────────────────────
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Language models ─────────────────────────────────────────────────────────
# Default provider family for the helper client: groq or litellm-routed providers.
LLM_PROVIDER=groq
# Model used by the helper client when a tier is not specified.
LLM_MODEL=llama-3.1-8b-instant
# Model used when INFERENCE_MODE=local, in LiteLLM provider/model form.
LLM_LOCAL=ollama/llama3.3
# Model used when a tier fails authentication and has no tier-specific fallback.
LLM_DEFAULT_FALLBACK=
# remote (default) uses the hosted tiers above; local sends every tier to LLM_LOCAL.
INFERENCE_MODE=remote
# Seconds to wait for one model call (default 30).
LLM_TIMEOUT=30
# Provider keys beyond the first: <PROVIDER>_API_KEY_<suffix> or <PROVIDER>_API_KEYS (comma or
# whitespace separated) are rotated; <PROVIDER>_KEY_SLOTS (for example "1,3") pins a subset.
# How many different Groq keys one call may try before using the fallback model (default 3).
GROQ_KEY_ATTEMPTS=3

# ── Live web search (chat) ──────────────────────────────────────────────────
# Questions about external companies, people or current events are searched on the web
# automatically (and always on an explicit request). The decision is rule based and the search
# runs in parallel with internal retrieval. Needs TAVILY_API_KEY (set above); without it chat
# answers from internal data only.
# Results per search (1 to 8, default 4).
WEB_SEARCH_MAX_RESULTS=4
# basic or advanced (deeper, slower).
WEB_SEARCH_DEPTH=basic
# Seconds before a web search request is abandoned (default 6).
WEB_SEARCH_TIMEOUT_SECONDS=6
# Extra seconds an automatic web search may take beyond internal retrieval before the answer
# proceeds without it (default 3.0). Explicit requests always wait for the results.
WEB_SEARCH_BUDGET_SECONDS=3.0
# Identical searches are served from memory for this many seconds (0 disables) / entries kept.
WEB_SEARCH_CACHE_TTL_SECONDS=600
WEB_SEARCH_CACHE_SIZE=128

# ── Chat behaviour ──────────────────────────────────────────────────────────
# Knowledge documents placed in chat context per question (default 3).
CHAT_DOC_TOP_K=3
# Label for the end of the loaded reporting period used in answers (default "June 2026").
DATA_CUTOFF_LABEL=June 2026
# Rerank with the cross-encoder inside chat as well (default false: chat uses the fused
# ranking, the progressive knowledge search refines it).
RERANK_IN_CHAT=false

# ── Retrieval tuning ────────────────────────────────────────────────────────
# Skip the cross-encoder when dense and lexical search agree on a clear leader.
RERANK_SKIP_WHEN_DECISIVE=true
# Margin by which the leader must win for the shortcut above (default 0.25).
RERANK_DECISIVE_MARGIN=0.25
# Cross-encoder runtime: torch (default) or onnx-int8 (smaller, faster on CPU).
RERANK_BACKEND=torch
# Seconds the reranker is skipped after a failure (default 30).
RERANK_FAIL_COOLDOWN=30
# Bearer token for RERANK_URL (defaults to INFERENCE_TOKEN).
RERANK_TOKEN=
# Hosted rerank API: base URL, model and timeout (used only when that provider is selected).
COHERE_BASE_URL=https://api.cohere.com
HOSTED_RERANK_MODEL=rerank-v3.5
HOSTED_RERANK_TIMEOUT=12
HF_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Same-language documents are boosted by this factor; other languages stay eligible (1.0 = off).
RETRIEVAL_LANGUAGE_BOOST=1.25
# Document chunking when ingesting: characters per chunk and overlap.
CHUNK_SIZE=900
CHUNK_OVERLAP=120
# Characters of each passage stored in the vector index (default 4000).
VECTOR_STORE_CONTENT_CHARS=4000
# Embedding calls retried this many times (default 4) and the poll delay while a remote host
# starts (seconds, default 15; total budget INFERENCE_WAKE_TIMEOUT).
EMBED_RETRY_ATTEMPTS=4
INFERENCE_RETRY_DELAY=15
# Alias of EMBED_URL accepted for shared configuration with sibling services.
EMBEDDING_ENDPOINT=
# Upper bounds in seconds for the whole hybrid or vector retrieval stage (empty = derived from
# RETRIEVAL_BASE_TIMEOUT and RETRIEVAL_TIMEOUT_PER_PAIR).
HYBRID_RETRIEVAL_TIMEOUT=150
VECTOR_RETRIEVAL_TIMEOUT=
# Qdrant collection name when VECTOR_STORE=qdrant.
QDRANT_COLLECTION=company_knowledge
# Model cache directory and Hugging Face token for gated or rate-limited model downloads.
HF_HOME=/app/model_cache
HF_TOKEN=

# ── Access and sessions ─────────────────────────────────────────────────────
# Internal tokens accepted when REQUIRE_INTERNAL_TOKEN=true (any one is enough).
INTERNAL_TOKEN=
OMNIINTEL_INTERNAL_TOKEN=
# Secret presented in X-Admin-Token for cross-session administrative reads.
ADMIN_TOKEN=
# Signing key for access tokens (defaults to SECRET_KEY) and token lifetime in minutes.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
# Secret deriving the key that protects stored credentials (falls back to the host name).
SESSION_SECRET=
# JSON object of additional users to create at start-up (see SELF_HOSTING.md).
OMNI_DEFAULT_USERS_JSON=
# Demo logins allowed per client address per minute (default 20).
DEMO_LOGIN_RATE_LIMIT=20

# ── Document and audio processing ───────────────────────────────────────────
# Route requested from the document service for images and scans: ocr_fallback (default),
# vision_route_a or vision_route_b. Text documents use DOC_PROCESSOR_TEXT_ROUTE.
# Minimum characters a text extraction must yield before it is accepted (default 200).
DOC_PROCESSOR_MIN_CHARS=200
# Transcription provider requested from the audio service (empty = service default) and timeout.
AUDIO_PROCESSOR_PROVIDER=
AUDIO_PROCESSOR_TIMEOUT=120
# Optional speech-synthesis endpoints for spoken answers: URL (or comma-separated URLs), bearer
# token, words per chunk and timeout in seconds.
TTS_ENDPOINT_URL=
TTS_ENDPOINT_URLS=
TTS_ENDPOINT_TOKEN=
TTS_CHUNK_WORDS=26
TTS_ENDPOINT_TIMEOUT=600

# ── Evaluation scripts (scripts/ and eval/) ─────────────────────────────────
# Judge timeout in seconds, delay between calls, retries and case limits used by the offline
# evaluation scripts; admin credentials are read from the environment, never from files.
JUDGE_TIMEOUT=30
RAGEVAL_CALL_DELAY_SECONDS=2
RAGEVAL_JUDGE_RETRY_ATTEMPTS=1
RAGEVAL_PACKAGE_N_CASES=12
EVAL_ONLY_CASE_IDS=
PROD_GATEWAY_URL=
PROD_ADMIN_TOKEN=
PROD_COST_ESTIMATE_MODEL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# ── Frontend build (Vite) ───────────────────────────────────────────────────
# API base URL when the dashboard is hosted separately. Empty = same origin.
VITE_API_BASE_URL=
# Dev server proxy target.
VITE_PROXY_TARGET=http://localhost:8000
# true to use the WebSocket chat transport instead of server-sent events.
VITE_USE_WS=false
# Display defaults for currency and language.
VITE_CURRENCY=USD
VITE_LANGUAGE=en
